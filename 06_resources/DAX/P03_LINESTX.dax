DEFINE
    VAR MonthlySales =
        SUMMARIZECOLUMNS(
            'Fact_Sales'[Month_Index],
            'Fact_Sales'[Month_Start],
            "MonthlySales", SUM('Fact_Sales'[Revenue])
        )
EVALUATE
    LINESTX(
        MonthlySales,
        [MonthlySales],
        'Fact_Sales'[Month_Index]
    )
